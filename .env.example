# xMender configuration. Copy to `.env` and adjust.
# Everything here is optional; the defaults below are what xMender uses
# when a key is left out.

# Port the web UI listens on.
XMENDER_PORT=25879

# Bind to all interfaces instead of 127.0.0.1 only. Leave off unless the UI
# sits behind a reverse proxy with HTTPS or on a trusted network.
XMENDER_ALLOW_EXTERNAL_ACCESS=false

# --- Useful extras -----------------------------------------------------------

# Where the database, the secret key and other state live.
# XMENDER_DATA_DIR=./data

# Database URL (SQLAlchemy format). Defaults to SQLite in XMENDER_DATA_DIR.
# For PostgreSQL install the extra first: .venv/bin/pip install "psycopg[binary]"
# XMENDER_DATABASE_URL=postgresql+psycopg://xmender:password@localhost/xmender

# Key used to encrypt stored passwords/API keys (Fernet, urlsafe base64, 32 bytes).
# If unset, one is generated into XMENDER_DATA_DIR/secret.key on first start.
# Losing it means re-entering every integration secret.
# XMENDER_SECRET_KEY=

# Minutes between automatic IMAP polls (1-60, recommended 5-10).
# XMENDER_POLL_INTERVAL_MINUTES=5

# Max new emails processed per inbox per poll.
# XMENDER_POLL_BATCH_SIZE=25

# Mark the session cookie Secure. Turn on when served over HTTPS.
# XMENDER_SECURE_COOKIES=false

# Session lifetime in days.
# XMENDER_SESSION_DAYS=14

# Let HTTP webhook integrations call addresses on this machine or the local
# network (127.0.0.1, 192.168.x.x, 10.x.x.x, ...). Off by default so task
# owners cannot reach internal services. Turn on to post to e.g. a LAN
# Home Assistant.
# XMENDER_HTTP_ALLOW_PRIVATE=false

# Logging: DEBUG, INFO, WARNING, ERROR
# XMENDER_LOG_LEVEL=INFO
